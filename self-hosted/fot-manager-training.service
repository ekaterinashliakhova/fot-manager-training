[Unit]
Description=FOT manager training statistics (no AI)
After=network.target

[Service]
Type=simple
User=fottraining
Group=fottraining
WorkingDirectory=/opt/fot-manager-training/current
ExecStart=/usr/bin/python3 /opt/fot-manager-training/current/server.py
Environment=FOT_LISTEN_HOST=127.0.0.1
Environment=FOT_PORT=8766
Environment=FOT_DATA_DIR=/var/lib/fot-manager-training
Environment=FOT_TRUST_PROXY=1
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
RestartSec=3
StateDirectory=fot-manager-training
StateDirectoryMode=0750
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/fot-manager-training

[Install]
WantedBy=multi-user.target
